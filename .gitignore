.specs/hooks/.commit-context.json

# Git worktrees
.worktrees/

# LiveSpec
.specs/hooks/*.local.md
.agents/skills/spec-*
.agents/skills/source-command-cli
.claude/skills/spec-*
.claude/skills/source-command-cli
.claude/rules/*.md
.claude/rules/livespec/
.codex/agents/livespec-*.toml
.claude/commands/spec.*.md
.claude/agents/livespec-*.md
.specs/.livespec-path
playwright-report/

# Local audit reports (consultative, not versioned)
AUDIT.md
AUDIT-CODEX.md

# Preflight report — execution artifact, never versioned
.specs/preflight-report.md

# Conventions debt JSON is regenerable; keep the Markdown report versioned.
.specs/conventions/debt.json

# LiveSpec local run artifacts (feature 039)
.specs/.runs/
/.tmp-orchestrate/

# LiveSpec local preview artifacts (feature 040, --save output)
.specs/.previews/

# Global write-lock target (feature 015/058) — runtime flock artifact
.specs/.LOCK
