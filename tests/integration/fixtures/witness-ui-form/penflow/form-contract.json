{
  "kind": "penflow-flow-contract",
  "version": 2,
  "contract_id": "required-item-form",
  "actors": [{"id": "operator", "name": "Local form operator"}],
  "entities": [{"id": "item", "fields": [{"id": "name", "type": "string"}]}],
  "flows": [{"id": "form", "entry_screen": "form"}],
  "screens": [{"id": "form", "flow_id": "form", "title": "Item form",
    "surface": "web", "root_node": "form.root", "viewport": {"width": 1280, "height": 720},
    "states": [{"id": "default"}, {"id": "success"}]}],
  "nodes": [
    {"id": "form.root", "semantic_id": "form", "test_id": "form", "role": "screen",
      "screen_id": "form", "children": ["form.name", "form.submit", "form.success"]},
    {"id": "form.name", "semantic_id": "item-name", "test_id": "item-name", "role": "input",
      "screen_id": "form", "binding": "item.name", "entity": "item", "action": "edit_name"},
    {"id": "form.submit", "semantic_id": "submit-item", "test_id": "submit-item", "role": "button",
      "screen_id": "form", "text": "Create item", "action": "submit_item"},
    {"id": "form.success", "semantic_id": "success", "test_id": "success", "role": "text",
      "screen_id": "form", "binding": "item.name", "entity": "item", "states": ["success"]}
  ],
  "actions": [{"id": "submit_item", "node": "form.submit", "trigger": "click",
    "kind": "state_change", "event": "submit", "guard": "required_name",
    "success_transition": "show_success"},
    {"id": "edit_name", "node": "form.name", "trigger": "input", "kind": "state_change",
      "event": "change", "binding_ref": {"entity": "item", "field": "name", "access": "write"}}],
  "guards": [{"id": "required_name"}],
  "permissions": [],
  "mutations": [],
  "transitions": [{"id": "show_success", "flow": "form", "action": "submit_item",
    "trigger": "submit_item", "from_screen": "form", "to_screen": "form",
    "from_state": "default", "to_state": "success"}],
  "needs_review": false,
  "needs_clarification": []
}
