#!/bin/sh
# @generated by conventions.init — do not edit manually
# Stack: Python + pyright
# To eject from auto-management, remove the @generated line above
set -e

check() {
    printf "→ %s\n" "$1"
    if ! eval "$1"; then
        printf "\n✗ FAILED: %s\n" "$1" >&2
        exit 1
    fi
}

# Python + pyright
if ! command -v ruff >/dev/null 2>&1; then
    printf "✗ ruff not found — install with: pip install ruff\n" >&2
    exit 1
fi
if ! command -v pyright >/dev/null 2>&1; then
    printf "✗ pyright not found — install with: pip install pyright\n" >&2
    exit 1
fi

check "ruff check ."

# Only type-check staged Python files
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$STAGED_PY" ]; then
    printf "→ pyright (staged files only)\n"
    if ! echo "$STAGED_PY" | xargs pyright; then
        printf "\n✗ FAILED: pyright (staged files)\n" >&2
        exit 1
    fi
else
    printf "→ pyright (no staged .py files — skipped)\n"
fi

printf "\n✓ All checks passed\n"
